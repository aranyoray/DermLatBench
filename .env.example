# Copy to .env for local use. .env is gitignored.
# All paths must be absolute.

# Data
DERMLAT_IMAGES_DIR=/absolute/path/to/images
DERMLAT_ANNOTATIONS_CSV=/absolute/path/to/annotations.csv
DERMLAT_MANUSCRIPT_DIR=

# Output (private; will contain audit results — keep off shared drives)
DERMLAT_OUTPUT_DIR=/absolute/path/to/private-results

# Backend selection: mlx | ollama | mock
DERMLAT_BACKEND=mlx

# MLX-VLM model name (Hugging Face id). Only pulled if you set DERMLAT_BACKEND=mlx.
DERMLAT_MLX_MODEL=mlx-community/Qwen2-VL-2B-Instruct-4bit

# Ollama configuration (if DERMLAT_BACKEND=ollama)
DERMLAT_OLLAMA_HOST=http://127.0.0.1:11434
DERMLAT_OLLAMA_MODEL=qwen2-vl:7b

# Reviewer UI port
DERMLAT_STREAMLIT_PORT=8765
